flowchart LR
    classDef entity fill:#c8e6c9,stroke:#388e3c,stroke-width:2px,font-weight:bold,font-size:14px
    classDef process fill:#2e7d32,stroke:#2e7d32,stroke-width:4px,color:#ffffff,font-weight:bold,font-size:14px
    classDef store fill:#ffffff,stroke:#388e3c,stroke-width:2px,font-weight:bold,font-size:13px

    Freelancer["Freelancer"]:::entity
    Client["Client"]:::entity
    IPFS["IPFS\nStorage"]:::store
    D3["D3:\nProposals"]:::store
    D2["D2: Jobs\n& Escrow"]:::store

    P1(("Validate\nJob & Role")):::process
    P2(("Store\nProposal")):::process
    P3(("Review &\nApprove")):::process
    P4(("Hire\nFreelancer")):::process

    Freelancer -->|"Cover Letter + Bid"| P1
    P1 -->|"Validated"| P2
    P2 -->|"Metadata"| IPFS
    IPFS -->|"IPFS CID"| P2
    P2 -->|"Store CID"| D3
    D3 -->|"Proposal Data"| P3
    Client -->|"Approve"| P3
    P3 -->|"Approved"| P4
    P4 -->|"Update Job"| D2
    P4 -->|"Payment"| Freelancer
    P4 -->|"Notification"| Client
